# Copy this file to .env.cloudflare and add your Cloudflare credentials.
# The real .env.cloudflare file is excluded from git.
CLOUDFLARE_ACCOUNT_ID=xxxxx
CLOUDFLARE_API_TOKEN=cfut_xxxxx

# Optional overrides:
CLOUDFLARE_PAGES_PROJECT_NAME=project-name
# CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main

# Required production hostname.
CLOUDFLARE_PAGES_CUSTOM_DOMAIN=example.com
# Optional comma-separated aliases; leave empty to skip alias setup and redirects.
CLOUDFLARE_PAGES_REDIRECT_DOMAINS=www.example.com
